# ROS2 build artifacts
build/
install/
log/

# Experiment results (raw data — büyük dosyalar).
# Kural aşağıda `results/*` bloğunda toplanır; burada ayrıca dışlamak
# istisnaları imkânsız kılıyordu (dışlanmış dizinin içi geri alınamaz).

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
*.so

# Gazebo / ROS runtime
*.lock

# Jupyter
.ipynb_checkpoints/

# Editor
.vscode/
.idea/
*.swp
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
nohup.out

# Python venv
.venv/
venv/

# Claude Code session
.claude/

# Tüm results/ outputs + arşiv (raw zaten yukarıda; outputs regenerable, _depo_archive büyük)
# (dizinin kendisi değil içeriği yoksayılır; aksi hâlde alttaki istisna işlemez)
results/*
# ...ama veri haritası izlenir: hangi dizin kanonik, zincir nasıl yeniden üretilir.
!results/README.md
# B1 ablasyonunun analiz çıktıları: makaledeki gazebo_ablation tablosunun ve
# keşifsel 5. kol paragrafının birebir kaynağı. Toplam 100 KB.
!results/ablation_analysis.txt
!results/arm5_exploratory.txt
# ...ve makale tablolarını besleyen küçük override: yoksa make_extra_tables /
# plot_results / statistical_analysis onu SESSİZCE atlar ve süperseded latency
# değerlerini üretir. 7 KB; kanonik veri değil, düzeltme katmanı.
!results/processed/
results/processed/*
!results/processed/ahe_latency_warmup.csv
# Aynı sözleşme haberleşme kolonu için: yoksa plot_results sessizce kampanyanın
# sabit 84 baytını çizer ve Şekil 12 metinle çelişir.
!results/processed/ahe_comm_footprint.csv
# Öncelik-çarpanı A/B'sinin özetleri (Limitasyon xi'deki sayıların kaynağı).
!results/processed/ab_prio_on.csv
!results/processed/ab_prio_off.csv
# Geodezik-ETA A/B'sinin özetleri (§VII-D ve Sınırlılık xiii'teki sayıların
# kaynağı). Seedwise dosyaları 400 KB, izlenmez; özetler 1 KB.
!results/processed/ab_geodesic_on.csv
!results/processed/ab_geodesic_off.csv
# Kanonik birleşik Gazebo özeti: 480 koşu, makaledeki tüm ölçek/karşılaştırma
# sayılarının kaynağı. 150 KB.
!results/processed/all_summary.csv
# Ham veri izlenmez AMA kampanyanın hangi yapılandırmayla üretildiği izlenir:
# bayraklar koşu artefaktlarında yoktu, bu not olmadan veri yorumlanamaz.
!results/raw/
results/raw/*
!results/raw/gazebo_benchmark_f58/
results/raw/gazebo_benchmark_f58/*
!results/raw/gazebo_benchmark_f58/CONFIG.md
# B1 ablasyon kampanyası (6 kol x 60/180 koşu = 480). Ön-kayıtlı dört kol +
# keşifsel fixed-spatial + n=20 baselines; sabit kolun hangi paradigmayla
# koştuğu YALNIZCA metadata.yaml içindeki AHE_FORCE_PARADIGM ile kanıtlanabilir,
# o yüzden metadata veriyle birlikte izlenir. CSV+yaml = 24 MB.
!results/raw/gazebo_ablation/
# ...ama 480 ROS2 launch log'u izlenmez: 142 MB, veri değil koşum gürültüsü.
results/raw/gazebo_ablation/**/*.log
results/raw/gazebo_ablation/*.log
# LaTeX build artefaktları (tex/pdf/cls/bst commit edilir)
*.aux
*.bbl
*.blg
*.out
*.toc
